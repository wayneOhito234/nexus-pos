# Postgres connection. Locally, wayneohito connects via peer auth over the
# unix socket, so PGHOST points at the socket directory, not localhost.
PGHOST=/var/run/postgresql
PGPORT=5432
PGDATABASE=nexus_pos
PGUSER=wayneohito
PGPASSWORD=

# Server
PORT=4000

# M-Pesa Daraja sandbox (fill in from https://developer.safaricom.co.ke/)
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=https://example.ngrok.io/api/mpesa/callback
